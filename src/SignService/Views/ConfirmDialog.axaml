<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SignService.Views.ConfirmDialog"
        Width="560" SizeToContent="Height" MaxHeight="640"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Подтверждение">

    <StackPanel Margin="16" Spacing="12">
        <ScrollViewer MaxHeight="420" HorizontalScrollBarVisibility="Disabled">
            <TextBlock Name="MessageText" TextWrapping="Wrap"/>
        </ScrollViewer>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Name="NoButton" Content="Нет" MinWidth="90"/>
            <Button Name="YesButton" Content="Да" Classes="accent" MinWidth="90"/>
        </StackPanel>
    </StackPanel>
</Window>
