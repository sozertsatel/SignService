<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SignService.ViewModels"
        x:Class="SignService.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="SignService — подписание документов ЭЦП"
        Width="980" Height="720"
        MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        DragDrop.AllowDrop="True">

    <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto">

        <!-- Выбор сертификата -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,0,0,8">
            <TextBlock Grid.Column="0" Text="Сертификат:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding Certificates}"
                      SelectedItem="{Binding SelectedCertificate}"
                      HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:CertificateItem">
                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="2" Margin="8,0,0,0"
                    Command="{Binding RefreshCertificatesCommand}"
                    ToolTip.Tip="Обновить список сертификатов">
                <TextBlock Text="⟳" FontSize="16"/>
            </Button>
            <Button Grid.Column="3" Margin="4,0,0,0"
                    ToolTip.Tip="Сохранение сертификата на компьютер: только для этой программы (PFX с паролем) или в хранилище Windows — для всех программ. Программа предупредит о рисках.">
                <TextBlock Text="💾" FontSize="14"/>
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuItem Header="Сохранить в программе (PFX с паролем)…"
                                  Command="{Binding SaveCertificateCommand}"
                                  ToolTip.Tip="Подписывать без ключа ЭЦП сможет только эта программа; при подписании запрашивается пароль."/>
                        <MenuItem Header="Установить в хранилище Windows (для всех программ)…"
                                  Command="{Binding InstallCertificateCommand}"
                                  ToolTip.Tip="Копия закрытого ключа устанавливается в хранилище «Текущий пользователь → Личное»: подписывать смогут и другие программы (КриптоАРМ, браузер и т.д.) без токена. Для сертификата с токена ключ сначала сохраняется в программе (PFX с паролем)."/>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <Button Grid.Column="4" Margin="4,0,0,0"
                    ToolTip.Tip="Удаление сохранённых копий сертификата. Токен не затрагивается.">
                <TextBlock Text="🗑" FontSize="14"/>
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuItem Header="Удалить сохранённую копию из программы"
                                  Command="{Binding DeleteCertificateCommand}"
                                  ToolTip.Tip="PFX-файл с ключом затирается и удаляется."/>
                        <MenuItem Header="Удалить из хранилища Windows"
                                  Command="{Binding RemoveFromStoreCommand}"
                                  ToolTip.Tip="Доступно только для сертификатов, которые установила эта программа."/>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!-- Параметры подписи -->
        <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <RadioButton GroupName="SigMode" Margin="0,0,16,4"
                         IsChecked="{Binding IsDetached}"
                         Content="Откреплённая подпись (.sig рядом с файлом)"
                         ToolTip.Tip="Файл .sig содержит только подпись. Такой формат требуют госпорталы и большинство систем документооборота."/>
            <RadioButton GroupName="SigMode" Margin="0,0,16,4"
                         IsChecked="{Binding !IsDetached}"
                         Content="Прикреплённая (документ внутри .sig)"/>
            <RadioButton GroupName="CoSignMode" Margin="0,0,16,4"
                         IsChecked="{Binding MergeWithExisting}"
                         Content="Добавить к существующей подписи"
                         ToolTip.Tip="Соподписание. При добавлении документа программа ищет в той же папке файлы .sig, .p7s и .p7m, относящиеся к нему по содержимому, даже если имя файла другое. Ваша подпись дописывается в выбранный файл, прежние подписанты сохраняются. Файл виден в строке документа."/>
            <RadioButton GroupName="CoSignMode" Margin="0,0,16,4"
                         IsChecked="{Binding !MergeWithExisting}"
                         Content="Создать новую"
                         ToolTip.Tip="Будет создан новый файл «документ.sig». Если в папке уже есть подходящая подпись или существующий файл будет заменён без объединения — программа спросит подтверждение; перед заменой сохраняется резервная копия."/>
            <CheckBox Margin="0,0,16,4"
                      IsChecked="{Binding IncludeExpiredCertificates}"
                      Content="Показывать просроченные сертификаты"/>
            <CheckBox Margin="0,0,0,4"
                      IsChecked="{Binding UseStamp}"
                      Content="Штамп на документ (PDF)"
                      ToolTip.Tip="Перед подписанием откроется диалог параметров штампа (страницы, дата, лого). По умолчанию подписывается ОРИГИНАЛ, а копия «имя (со штампом).pdf» — отдельный файл без подписи с плашками всех подписантов (безопасно при соподписании)."/>
        </WrapPanel>

        <!-- Доверенность (МЧД) -->
        <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Доверенность (МЧД):" VerticalAlignment="Center" Margin="0,0,8,4"/>
            <Button Margin="0,0,8,4" Padding="8,3"
                    Content="Добавить доверенность…"
                    Command="{Binding AddPoaCommand}"
                    ToolTip.Tip="Как в Контуре: выберите файл МЧД (XML) и подпись руководителя (.sig). Программа проверит подпись, срок действия и соответствие представителя вашему сертификату. Файлы МЧД будут скопированы рядом с подписанным документом, номер МЧД попадёт в штамп на PDF."/>
            <TextBlock Margin="0,0,8,4" VerticalAlignment="Center"
                       Text="{Binding PoaDisplay}"
                       Foreground="{DynamicResource SystemAccentColor}"
                       ToolTip.Tip="{Binding PoaDisplay}"/>
            <Button Margin="0,0,0,4" Padding="6,3"
                    Command="{Binding ClearPoaCommand}"
                    IsVisible="{Binding HasPoa}"
                    ToolTip.Tip="Убрать доверенность">
                <TextBlock Text="✕" FontSize="10"/>
            </Button>
        </WrapPanel>

        <!-- Команды списка: над зоной перетаскивания -->
        <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,Auto,*,Auto" Margin="0,0,0,8">
            <Button Grid.Column="0" Content="Обзор…" Command="{Binding BrowseCommand}"/>
            <Button Grid.Column="1" Margin="8,0,0,0" Content="Инструменты ▾"
                    ToolTip.Tip="Операции с подписями без подписания: проверка, извлечение, разделение, сборка контейнера, штамп">
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuItem Header="Проверить ЭЦП… (подписанты, ГОСТ без КриптоПро)"
                                  Command="{Binding VerifySignatureCommand}"/>
                        <Separator/>
                        <MenuItem Header="Извлечь из .sig… (документ и подписи из контейнера)"
                                  Command="{Binding ExtractCommand}"/>
                        <MenuItem Header="Разделить групповую подпись… (отдельная .sig для каждого)"
                                  Command="{Binding SplitSignaturesCommand}"/>
                        <MenuItem Header="Исключить подписанта из .sig…"
                                  Command="{Binding RemoveSignerCommand}"/>
                        <MenuItem Header="Собрать контейнер… (документ + подписи в один .sig)"
                                  Command="{Binding BuildContainerCommand}"/>
                        <MenuItem Header="Штамп на PDF… (копия со штампом без подписания)"
                                  Command="{Binding StampOnlyCommand}"/>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <CheckBox Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"
                      IsChecked="{Binding ApplyCoSignToAll}"
                      Content="Применить ко всем"
                      ToolTip.Tip="Все файлы берут режим первого в списке: «Создать новую» или «Добавить к существующей». Если подходящей подписи нет, строка остаётся на «Создать новую» и пишет об этом. Галочка запоминается."/>
            <Button Grid.Column="4" Content="Очистить список" Command="{Binding ClearCommand}"
                    HorizontalAlignment="Right"/>
        </Grid>

        <!-- Зона перетаскивания / список файлов -->
        <Border Grid.Row="4"
                Name="DropZone"
                BorderThickness="2"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                CornerRadius="8"
                Background="Transparent">
            <Border.Styles>
                <Style Selector="Border#DropZone.dragover">
                    <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}"/>
                    <Setter Property="Background" Value="#22808080"/>
                </Style>
            </Border.Styles>

            <Panel>
                <!-- Подсказка, когда файлов нет -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                            IsVisible="{Binding !Files.Count}">
                    <TextBlock Text="📄" FontSize="48" HorizontalAlignment="Center"/>
                    <TextBlock Text="Перетащите файлы сюда"
                               FontSize="18" HorizontalAlignment="Center"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    <TextBlock Text="или воспользуйтесь кнопкой «Обзор…»"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                </StackPanel>

                <!-- Очередь файлов -->
                <ScrollViewer IsVisible="{Binding Files.Count}">
                    <ItemsControl ItemsSource="{Binding Files}" Margin="8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SignFileItem">
                                <Border Margin="0,2" Padding="10,6" CornerRadius="6"
                                        Background="{DynamicResource SystemControlBackgroundListLowBrush}">
                                    <Border.ContextMenu>
                                        <!-- Меню — всплывающее окно вне визуального дерева: $parent[...] здесь
                                             не находит список, поэтому команды берутся у владельца элемента. -->
                                        <ContextMenu>
                                            <MenuItem Header="Подписанты и проверка ЭЦП…"
                                                      Command="{Binding Owner.InspectSignaturesCommand}"
                                                      CommandParameter="{Binding}"/>
                                            <MenuItem Header="Приложить подписи других лиц (＋.sig)…"
                                                      Command="{Binding Owner.AttachSignaturesCommand}"
                                                      CommandParameter="{Binding}"/>
                                            <Separator/>
                                            <MenuItem Header="Штамп на PDF (копия без подписи)…"
                                                      Command="{Binding Owner.StampItemCommand}"
                                                      CommandParameter="{Binding}"/>
                                            <MenuItem Header="Извлечь из контейнера (.sig рядом)"
                                                      Command="{Binding Owner.ExtractItemCommand}"
                                                      CommandParameter="{Binding}"/>
                                            <MenuItem Header="Собрать контейнер (документ + .sig рядом)"
                                                      Command="{Binding Owner.BuildContainerItemCommand}"
                                                      CommandParameter="{Binding}"/>
                                            <MenuItem Header="Разделить групповую подпись (.sig рядом)"
                                                      Command="{Binding Owner.SplitItemCommand}"
                                                      CommandParameter="{Binding}"/>
                                            <MenuItem Header="Исключить подписанта из .sig…"
                                                      Command="{Binding Owner.RemoveSignerItemCommand}"
                                                      CommandParameter="{Binding}"/>
                                            <Separator/>
                                            <MenuItem Header="Открыть папку файла"
                                                      Command="{Binding Owner.OpenFolderCommand}"
                                                      CommandParameter="{Binding}"/>
                                            <MenuItem Header="Убрать из списка"
                                                      Command="{Binding Owner.RemoveFileCommand}"
                                                      CommandParameter="{Binding}"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding FileName}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ExtraDisplay}"
                                                       IsVisible="{Binding HasExtra}"
                                                       VerticalAlignment="Center" Margin="8,0"
                                                       Foreground="{DynamicResource SystemAccentColor}"
                                                       ToolTip.Tip="Приложенные подписи других лиц будут объединены с вашей в один .sig"/>
                                            <TextBlock Text="{Binding SizeDisplay}"
                                                       VerticalAlignment="Center" Margin="8,0"
                                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                            <Button Margin="8,0,0,0" Padding="6,2"
                                                    Command="{Binding Owner.AttachSignaturesCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="Приложить подписи других лиц (.sig, .p7s). Если подпись относится к этому документу, она находится и по хешу, не только по имени.">
                                                <TextBlock Text="＋.sig"/>
                                            </Button>
                                            <Button Margin="4,0,0,0" Padding="6,2"
                                                    Command="{Binding Owner.RemoveFileCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="Убрать из списка">
                                                <TextBlock Text="✕"/>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                   Text="{Binding FilePath}" FontSize="11"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <ComboBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                                  Margin="0,4,0,0" HorizontalAlignment="Left"
                                                  MinWidth="280" MaxWidth="560"
                                                  ItemsSource="{Binding CoSignOptions}"
                                                  SelectedItem="{Binding SelectedCoSignOption}"
                                                  IsEnabled="{Binding CanChooseCoSign}"
                                                  ToolTip.Tip="{Binding SelectedCoSignOption.Label}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:CoSignOption">
                                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                                   Margin="0,4,0,0" Text="{Binding StatusDisplay}"
                                                   TextWrapping="Wrap" FontSize="12"
                                                   ToolTip.Tip="{Binding StatusDisplay}"/>
                                        <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                                                   Margin="0,2,0,0" Text="{Binding WarningDisplay}"
                                                   TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="#C2410C"
                                                   IsVisible="{Binding HasWarning}"
                                                   ToolTip.Tip="{Binding WarningDisplay}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Panel>
        </Border>

        <!-- Подписание: та же вертикаль, кнопка у правого края, как «Очистить список» -->
        <Grid Grid.Row="5" ColumnDefinitions="*,Auto,Auto" Margin="0,12,0,0">
            <ProgressBar Grid.Column="1" IsIndeterminate="True" Width="120"
                         Margin="0,0,8,0" IsVisible="{Binding IsBusy}" VerticalAlignment="Center"/>
            <Button Grid.Column="2" Content="Подписать"
                    Command="{Binding SignAllCommand}"
                    Classes="accent"
                    FontWeight="SemiBold"
                    Padding="24,6"
                    HorizontalAlignment="Right"/>
        </Grid>

        <!-- Лог операций (всегда виден) -->
        <Grid Grid.Row="6" RowDefinitions="Auto,Auto" Margin="0,8,0,0">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="Лог операций" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Очистить" Padding="8,2"
                        Command="{Binding ClearLogCommand}"/>
            </Grid>
            <TextBox Grid.Row="1" Name="LogBox" Margin="0,4,0,0"
                     Text="{Binding LogText, Mode=OneWay}"
                     IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                     FontFamily="Consolas,Menlo,monospace" FontSize="11"
                     Height="120"/>
        </Grid>

        <!-- Нижняя строка: версия и служебные окна -->
        <Grid Grid.Row="7" ColumnDefinitions="*,Auto,Auto" Margin="0,10,0,0">
            <TextBlock Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center"
                       Text="{Binding VersionDisplay}"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            <Button Grid.Column="1" Name="SettingsButton" Padding="8,2" Margin="0,0,8,0"
                    Content="Настройки…"
                    ToolTip.Tip="Резервная копия .sig, штамп времени (CAdES-T) и адрес службы TSA"/>
            <Button Grid.Column="2" Name="AboutButton" Padding="8,2" Content="О программе"
                    ToolTip.Tip="Версия, автор, история версий и обновления"/>
        </Grid>
    </Grid>
</Window>
