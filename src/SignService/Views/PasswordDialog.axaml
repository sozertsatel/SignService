<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SignService.Views.PasswordDialog"
        Width="480" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Пароль">

    <StackPanel Margin="16" Spacing="10">
        <TextBlock Name="MessageText" TextWrapping="Wrap"/>

        <TextBlock Name="WarningText" TextWrapping="Wrap"
                   Foreground="#B25000" FontWeight="SemiBold" IsVisible="False"/>

        <TextBlock Text="Пароль:"/>
        <TextBox Name="PasswordBox" PasswordChar="●"/>

        <StackPanel Name="ConfirmPanel" Spacing="10" IsVisible="False">
            <TextBlock Text="Пароль ещё раз:"/>
            <TextBox Name="ConfirmBox" PasswordChar="●"/>
        </StackPanel>

        <TextBlock Name="ErrorText" Foreground="Red" IsVisible="False" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
            <Button Name="CancelButton" Content="Отмена" MinWidth="90"/>
            <Button Name="OkButton" Content="ОК" Classes="accent" MinWidth="90"/>
        </StackPanel>
    </StackPanel>
</Window>
